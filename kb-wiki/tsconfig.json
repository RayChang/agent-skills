{
  // Editor-only config: gives the TS language server Bun + Node ambient types
  // (Bun, process, require, import.meta.main) so the scripts stop showing phantom
  // "cannot find name" errors. The scripts are still run with `bun script.ts`; nothing
  // is compiled from here (noEmit). Strict checks are intentionally left off so this
  // does not retro-flag existing loosely-typed code — it only resolves the globals.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["scripts/**/*.ts"]
}
